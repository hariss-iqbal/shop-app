{
  "id": "auth-login-wrong-password",
  "testNumber": 2,
  "area": "auth",
  "name": "Login with wrong password shows error message",
  "requiresAuth": false,
  "preconditions": {
    "requiresSeedData": false
  },
  "steps": [
    {
      "id": "navigate-login",
      "action": "navigate",
      "target": "/auth/login"
    },
    {
      "id": "wait-form",
      "action": "waitFor",
      "text": "Sign in",
      "timeout": 5000
    },
    {
      "id": "fill-email",
      "action": "type",
      "selector": "#email",
      "value": "admin@gmail.com"
    },
    {
      "id": "fill-wrong-password",
      "action": "type",
      "selector": "#password",
      "value": "wrongpassword"
    },
    {
      "id": "click-signin",
      "action": "click",
      "description": "Click the Sign In button",
      "useSnapshot": true,
      "snapshotLabel": "Sign In"
    },
    {
      "id": "wait-error",
      "action": "waitFor",
      "text": "Invalid login credentials",
      "timeout": 10000
    },
    {
      "id": "assert-still-on-login",
      "action": "assert",
      "type": "url",
      "assertion": "contains",
      "expected": "/auth/login"
    }
  ],
  "priority": "P0",
  "businessContext": "Auth is critical — users cannot access admin panel without working login"
}